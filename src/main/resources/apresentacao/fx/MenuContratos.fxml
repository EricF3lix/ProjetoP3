<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="apresentacao.fx.MenuContratosController">
   <padding>
      <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
   </padding>
   <top>
      <Label style="-fx-font-size: 22px; -fx-font-weight: bold;" text="Gerenciar Contratos" BorderPane.alignment="CENTER_LEFT">
         <BorderPane.margin>
            <Insets bottom="12.0" />
         </BorderPane.margin>
      </Label>
   </top>
   <left>
      <VBox prefWidth="260.0" spacing="8.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets right="12.0" />
         </padding>
         <children>
            <TextField fx:id="pesquisa" promptText="Busque por ID/Cliente/Status" />
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#buscarContrato" text="Buscar Contrato por ID" />
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#registrarAluguel" text="Registrar Aluguel" />
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#listarContratos" text="Listar todos os Contratos" />
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#finalizarContrato" text="Finalizar Contrato (devolução)" />
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#cancelarContrato" text="Cancelar Contrato" />
            <Separator />
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#voltar" text="Voltar" />
         </children>
      </VBox>
   </left>
   <center>
      <TableView fx:id="tabela" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
        <columns>
          <TableColumn prefWidth="50.0" text="ID">
             <cellValueFactory><PropertyValueFactory property="id" /></cellValueFactory>
          </TableColumn>
          <TableColumn prefWidth="160.0" text="Cliente">
             <cellValueFactory><PropertyValueFactory property="cliente" /></cellValueFactory>
          </TableColumn>
          <TableColumn prefWidth="160.0" text="Item">
             <cellValueFactory><PropertyValueFactory property="item" /></cellValueFactory>
          </TableColumn>
          <TableColumn prefWidth="100.0" text="Data Início">
             <cellValueFactory><PropertyValueFactory property="dataInicio" /></cellValueFactory>
          </TableColumn>
          <TableColumn prefWidth="100.0" text="Data Fim">
             <cellValueFactory><PropertyValueFactory property="dataFimPrevista" /></cellValueFactory>
          </TableColumn>
          <TableColumn prefWidth="90.0" text="Status">
             <cellValueFactory><PropertyValueFactory property="status" /></cellValueFactory>
          </TableColumn>
          <TableColumn prefWidth="90.0" text="Valor Total">
             <cellValueFactory><PropertyValueFactory property="valorTotal" /></cellValueFactory>
          </TableColumn>
        </columns>
      </TableView>
   </center>
</BorderPane>