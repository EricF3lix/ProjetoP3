<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="660.0" prefWidth="950.0" style="-fx-background-color: #F5F5F7;" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="apresentacao.fx.MenuClienteController">
   <children>
      
      <Label layoutX="40.0" layoutY="25.0" style="-fx-font-family: -apple-system, 'SF Pro Display', 'Segoe UI', sans-serif; -fx-font-weight: 900; -fx-font-size: 26px; -fx-text-fill: #1d1d1f;" text="Área do Cliente" />
      <Label layoutX="40.0" layoutY="58.0" style="-fx-font-family: -apple-system, 'SF Pro Text', 'Segoe UI', sans-serif; -fx-font-size: 14px; -fx-text-fill: #86868b;" text="Consulte seus aluguéis, multas e itens disponíveis" />

      
      <VBox layoutX="40.0" layoutY="100.0" prefWidth="250.0" spacing="12.0">
         <children>
            
            <Label fx:id="bemVindo" alignment="CENTER" prefWidth="250.0" style="-fx-font-family: -apple-system, 'SF Pro Text', 'Segoe UI', sans-serif; -fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #1d1d1f; -fx-background-color: #e5e5ea; -fx-background-radius: 10px; -fx-padding: 10px;" text="bemVindo" textAlignment="CENTER" />
            <Pane prefHeight="2.0" />

            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#listarItensDisponiveis" prefHeight="38.0" style="-fx-background-color: #ffffff; -fx-background-radius: 10px; -fx-border-color: #d1d1d6; -fx-border-radius: 10px; -fx-text-fill: #007AFF; -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 13px;" text="Ver itens disponíveis" />
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#listarAlugueisAtivos" prefHeight="38.0" style="-fx-background-color: #ffffff; -fx-background-radius: 10px; -fx-border-color: #d1d1d6; -fx-border-radius: 10px; -fx-text-fill: #1d1d1f; -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 13px;" text="Meus aluguéis ativos" />
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#historicoAlugueis" prefHeight="38.0" style="-fx-background-color: #ffffff; -fx-background-radius: 10px; -fx-border-color: #d1d1d6; -fx-border-radius: 10px; -fx-text-fill: #1d1d1f; -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 13px;" text="Histórico de aluguéis" />
            
            <Separator style="-fx-padding: 5 0 5 0;" />
            
            
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#multasPendentes" prefHeight="38.0" style="-fx-background-color: #ffffff; -fx-background-radius: 10px; -fx-border-color: #d1d1d6; -fx-border-radius: 10px; -fx-text-fill: #f44336; -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 13px;" text="Minhas multas pendentes" />
            
            <Pane prefHeight="5.0" />
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#voltar" prefHeight="38.0" style="-fx-background-color: #e5e5ea; -fx-background-radius: 10px; -fx-text-fill: #1d1d1f; -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 13px;" text="Voltar" />
         </children>
      </VBox>

     
      <AnchorPane AnchorPane.topAnchor="100.0" AnchorPane.leftAnchor="320.0" AnchorPane.rightAnchor="40.0" AnchorPane.bottomAnchor="40.0" prefWidth="590.0" style="-fx-background-color: #ffffff; -fx-background-radius: 16px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 12, 0, 2, 6);">
         <children>
            <VBox spacing="15.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </padding>
               <children>
                  <Label style="-fx-font-family: -apple-system, 'SF Pro Display', 'Segoe UI', sans-serif; -fx-font-weight: bold; -fx-font-size: 18px; -fx-text-fill: #1d1d1f;" text="Painel de Consulta" />
                  
                  <StackPane VBox.vgrow="ALWAYS">
                     <children>
                        
                        <TableView fx:id="tabelaItens" style="-fx-border-color: #e5e5ea; -fx-border-radius: 8px; -fx-background-radius: 8px;">
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                           <columns>
                              <TableColumn prefWidth="40.0" text="ID">
                                 <cellValueFactory><PropertyValueFactory property="id" /></cellValueFactory>
                              </TableColumn>
                              <TableColumn prefWidth="200.0" text="Nome">
                                 <cellValueFactory><PropertyValueFactory property="nome" /></cellValueFactory>
                              </TableColumn>
                              <TableColumn prefWidth="150.0" text="Categoria">
                                 <cellValueFactory><PropertyValueFactory property="categoriaNome" /></cellValueFactory>
                              </TableColumn>
                              <TableColumn prefWidth="90.0" text="Taxa/Dia">
                                 <cellValueFactory><PropertyValueFactory property="taxaDiaria" /></cellValueFactory>
                              </TableColumn>
                           </columns>
                        </TableView>

                       
                        <TableView fx:id="tabelaContratos" managed="false" style="-fx-border-color: #e5e5ea; -fx-border-radius: 8px; -fx-background-radius: 8px;" visible="false">
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                           <columns>
                              <TableColumn prefWidth="40.0" text="ID">
                                 <cellValueFactory><PropertyValueFactory property="id" /></cellValueFactory>
                              </TableColumn>
                              <TableColumn prefWidth="150.0" text="Item">
                                 <cellValueFactory><PropertyValueFactory property="itemNome" /></cellValueFactory>
                              </TableColumn>
                              <TableColumn prefWidth="100.0" text="Retirada">
                                 <cellValueFactory><PropertyValueFactory property="dataRetirada" /></cellValueFactory>
                              </TableColumn>
                              <TableColumn prefWidth="110.0" text="Devolução">
                                 <cellValueFactory><PropertyValueFactory property="dataDevolucaoPrevista" /></cellValueFactory>
                              </TableColumn>
                              <TableColumn prefWidth="90.0" text="Status">
                                 <cellValueFactory><PropertyValueFactory property="status" /></cellValueFactory>
                              </TableColumn>
                              <TableColumn prefWidth="90.0" text="Valor total">
                                 <cellValueFactory><PropertyValueFactory property="valorTotal" /></cellValueFactory>
                              </TableColumn>
                              <TableColumn prefWidth="90.0" text="Multa">
                                 <cellValueFactory><PropertyValueFactory property="valorMulta" /></cellValueFactory>
                              </TableColumn>
                           </columns>
                        </TableView>
                     </children>
                  </StackPane>
               </children>
            </VBox>
         </children>
      </AnchorPane>
   </children>
</AnchorPane>