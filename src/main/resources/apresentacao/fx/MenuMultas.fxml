                        <Font size="15.0" />
                     </font>
                  </Label>
                  <TextField fx:id="idContrato" promptText="ID do contrato">
                     <VBox.margin>
                        <Insets left="15.0" right="15.0" />
                     </VBox.margin>
                  </TextField>
                  <Label text="Tipo de multa:">
                     <font>
                        <Font size="15.0" />
                     </font>
                     <VBox.margin>
                        <Insets left="15.0" top="15.0" />
                     </VBox.margin>
                  </Label>
                  <ComboBox fx:id="tipoMulta" prefHeight="26.0" prefWidth="585.0" promptText="Selecionar tipo da multa">
