                     </VBox.margin>
                  </ComboBox>
                  <Label text="Descrição:">
                     <font>
                        <Font size="15.0" />
                     </font>
                     <VBox.margin>
                        <Insets left="15.0" right="15.0" top="15.0" />
                     </VBox.margin>
                  </Label>
                  <TextField fx:id="descricaoMulta" promptText="Descrição da ocorrencia">
                     <VBox.margin>
                        <Insets left="15.0" right="15.0" />
                     </VBox.margin>
                  </TextField>
                  <Label text="Valor (R$) :">
                     <font>
                        <Font size="15.0" />
                     </font>
                     <VBox.margin>
                        <Insets left="15.0" right="15.0" top="15.0" />
                     </VBox.margin>
                  </Label>
                  <TextField fx:id="valorMulta" promptText="Ex: 50,0">
                     <VBox.margin>
                        <Insets left="15.0" right="15.0" />
                     </VBox.margin>
                  </TextField>
                  <Region prefHeight="236.0" prefWidth="590.0" />
                  <HBox prefHeight="100.0" prefWidth="200.0">
                     <children>
                        <Region prefHeight="48.0" prefWidth="440.0" />
                        <Button alignment="CENTER" mnemonicParsing="false" onAction="#registrarMulta" prefHeight="33.0" prefWidth="138.0" text="Registrar multa" />
                     </children>
                  </HBox>
               </children>
               <opaqueInsets>
                  <Insets />
               </opaqueInsets>
            </VBox>
            <VBox fx:id="tabelaMulta" spacing="15.0">
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </padding>
               <children>
                  <Label style="-fx-font-family: -apple-system, 'SF Pro Display', 'Segoe UI', sans-serif; -fx-font-weight: bold; -fx-font-size: 18px; -fx-text-fill: #1d1d1f;" text="Lista de Multas" />
                  <TableView fx:id="tabela" style="-fx-border-color: #e5e5ea; -fx-border-radius: 8px; -fx-background-radius: 8px;" VBox.vgrow="ALWAYS">
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                     <columns>
                        <TableColumn fx:id="colID" prefWidth="40.0" text="ID" />
                        <TableColumn fx:id="colContrato" prefWidth="75.0" text="Contrato" />
                        <TableColumn fx:id="colTipo" prefWidth="75.0" text="Tipo" />
                        <TableColumn fx:id="colDescricao" prefWidth="120.0" text="Descrição" />
                        <TableColumn fx:id="colValor" prefWidth="75.0" text="Valor" />
                        <TableColumn fx:id="colStatus" prefWidth="75.0" text="Status" />
                        <TableColumn fx:id="colData" prefWidth="105.0" text="Data de Criação" />
                     </columns>
                  </TableView>
               </children>
