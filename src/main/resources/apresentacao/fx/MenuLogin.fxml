<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="600.0" prefWidth="900.0" spacing="12.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="apresentacao.fx.MenuLoginController">
   <padding>
      <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
   </padding>
   <children>
      <Label style="-fx-font-size: 26px; -fx-font-weight: bold;" text="LOJA QUE ALUGA DE UM TUDO" />
      <Label alignment="CENTER" contentDisplay="CENTER" prefHeight="24.0" prefWidth="125.0" text="Entrar no sistema">
         <VBox.margin>
            <Insets bottom="12.0" />
         </VBox.margin>
      </Label>
      <TextField fx:id="txtEmail" maxWidth="320.0" promptText="Email" />
      <PasswordField fx:id="txtSenha" maxWidth="320.0" onAction="#entrar" promptText="Senha" />
      <Button defaultButton="true" maxWidth="320.0" mnemonicParsing="false" onAction="#entrar" text="Entrar" />
      <Button maxWidth="320.0" mnemonicParsing="false" onAction="#voltar" text="Encerrar" />
   </children>
</VBox>
