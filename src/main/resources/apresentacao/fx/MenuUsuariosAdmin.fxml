<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="650.0" prefWidth="880.0" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="apresentacao.fx.MenuUsuariosAdminController">
   <children>
      <Label layoutX="35.0" layoutY="25.0" text="Gerenciar Usuários (Administrador)">
         <font>
            <Font name="System Bold" size="22.0" />
         </font>
      </Label>

      <!-- Coluna de Botões do Menu -->
      <VBox layoutX="35.0" layoutY="70.0" prefWidth="240.0" spacing="10.0">
         <children>
            <Button fx:id="btnCadastrarCliente" mnemonicParsing="false" onAction="#aoCadastrarCliente" prefHeight="35.0" prefWidth="240.0" text="Cadastrar Cliente" />
            <Button fx:id="btnCadastrarFuncionario" mnemonicParsing="false" onAction="#aoCadastrarFuncionario" prefHeight="35.0" prefWidth="240.0" text="Cadastrar Funcionário" />
            <Button fx:id="btnCadastrarAdmin" mnemonicParsing="false" onAction="#aoCadastrarAdmin" prefHeight="35.0" prefWidth="240.0" text="Cadastrar Administrador" />
            <Button fx:id="btnBuscarUsuario" mnemonicParsing="false" onAction="#aoBuscarUsuario" prefHeight="35.0" prefWidth="240.0" text="Buscar Usuário por ID" />
            <Button fx:id="btnListarUsuarios" mnemonicParsing="false" onAction="#aoListarUsuarios" prefHeight="35.0" prefWidth="240.0" text="Listar todos os Usuários" />
            <Button fx:id="btnAtualizarUsuario" mnemonicParsing="false" onAction="#aoAtualizarUsuario" prefHeight="35.0" prefWidth="240.0" text="Atualizar Usuário" />
            <Button fx:id="btnDesativarUsuario" mnemonicParsing="false" onAction="#aoDesativarUsuario" prefHeight="35.0" prefWidth="240.0" text="Desativar Usuário" />
            
            <Pane prefHeight="10.0" />
            
            <Button fx:id="btnVoltar" mnemonicParsing="false" onAction="#aoVoltar" prefHeight="35.0" prefWidth="240.0" text="Voltar" />
         </children>
      </VBox>

      <!-- Painel Dinâmico da Direita -->
      <AnchorPane fx:id="painelConteudo" layoutX="300.0" layoutY="70.0" prefHeight="550.0" prefWidth="540.0" style="-fx-border-color: #cccccc; -fx-background-color: #ffffff;" />
   </children>
</AnchorPane>