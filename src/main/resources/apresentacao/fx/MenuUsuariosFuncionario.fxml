<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="850.0" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="apresentacao.fx.MenuUsuariosFuncionarioController">
   <children>
      <!-- Título idêntico ao padrão da equipa -->
      <Label layoutX="35.0" layoutY="30.0" text="Gerenciar Usuários">
         <font>
            <Font name="System Bold" size="22.0" />
         </font>
      </Label>

      <!-- Coluna de Botões do Menu à Esquerda -->
      <VBox layoutX="35.0" layoutY="75.0" prefWidth="240.0" spacing="12.0">
         <children>
            <Button fx:id="btnCadastrarCliente" mnemonicParsing="false" onAction="#aoCadastrarCliente" prefHeight="35.0" prefWidth="240.0" text="Cadastrar Cliente" />
            <Button fx:id="btnBuscarUsuario" mnemonicParsing="false" onAction="#aoBuscarUsuario" prefHeight="35.0" prefWidth="240.0" text="Buscar Usuário por ID" />
            <Button fx:id="btnListarUsuarios" mnemonicParsing="false" onAction="#aoListarUsuarios" prefHeight="35.0" prefWidth="240.0" text="Listar todos os Usuários" />
            
            <Pane prefHeight="15.0" /> <!-- Espaçador antes do Voltar -->
            
            <Button fx:id="btnVoltar" mnemonicParsing="false" onAction="#aoVoltar" prefHeight="35.0" prefWidth="240.0" text="Voltar" />
         </children>
      </VBox>

      <!-- Painel Dinâmico da Direita (onde os formulários e listas vão aparecer) -->
      <AnchorPane fx:id="painelConteudo" layoutX="300.0" layoutY="75.0" prefHeight="480.0" prefWidth="510.0" style="-fx-border-color: #cccccc; -fx-background-color: #ffffff;" />
   </children>
</AnchorPane>