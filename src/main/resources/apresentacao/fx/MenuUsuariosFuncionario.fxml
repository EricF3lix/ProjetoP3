<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="painelConteudo" prefHeight="660.0" prefWidth="950.0" style="-fx-background-color: #F5F5F7;" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="apresentacao.fx.MenuUsuariosFuncionarioController">
   <children>
     
      <Label layoutX="40.0" layoutY="25.0" style="-fx-font-family: -apple-system, 'SF Pro Display', 'Segoe UI', sans-serif; -fx-font-weight: 900; -fx-font-size: 26px; -fx-text-fill: #1d1d1f;" text="Gestão de Usuários" />
      <Label layoutX="40.0" layoutY="58.0" style="-fx-font-family: -apple-system, 'SF Pro Text', 'Segoe UI', sans-serif; -fx-font-size: 14px; -fx-text-fill: #86868b;" text="Painel do Funcionário" />

    
      <VBox layoutX="40.0" layoutY="100.0" prefWidth="250.0" spacing="12.0">
         <children>
            <Button fx:id="btnCadastrarCliente" mnemonicParsing="false" onAction="#aoCadastrarCliente" prefHeight="38.0" prefWidth="250.0" style="-fx-background-color: #ffffff; -fx-background-radius: 10px; -fx-border-color: #d1d1d6; -fx-border-radius: 10px; -fx-text-fill: #007AFF; -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 13px;" text="Cadastrar Cliente" />
            
            <Separator style="-fx-padding: 5 0 5 0;" />
            
            <Button fx:id="btnBuscarUsuario" mnemonicParsing="false" onAction="#aoBuscarUsuario" prefHeight="38.0" prefWidth="250.0" style="-fx-background-color: #ffffff; -fx-background-radius: 10px; -fx-border-color: #d1d1d6; -fx-border-radius: 10px; -fx-text-fill: #1d1d1f; -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 13px;" text="Buscar Usuário por ID" />
            <Button fx:id="btnListarUsuarios" mnemonicParsing="false" onAction="#aoListarUsuarios" prefHeight="38.0" prefWidth="250.0" style="-fx-background-color: #ffffff; -fx-background-radius: 10px; -fx-border-color: #d1d1d6; -fx-border-radius: 10px; -fx-text-fill: #1d1d1f; -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 13px;" text="Listar todos os Usuários" />
            
            <Pane prefHeight="5.0" />
            <Button fx:id="btnVoltar" mnemonicParsing="false" onAction="#voltar" prefHeight="38.0" prefWidth="250.0" style="-fx-background-color: #e5e5ea; -fx-background-radius: 10px; -fx-text-fill: #1d1d1f; -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 13px;" text="Voltar" />
         </children>
      </VBox>

     
      <AnchorPane layoutX="320.0" layoutY="100.0" prefHeight="520.0" prefWidth="590.0" style="-fx-background-color: #ffffff; -fx-background-radius: 16px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 12, 0, 2, 6);">
         <children>
            <StackPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
               <children>
                 
                  <VBox fx:id="painelTabela" spacing="12.0">
                     <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                     </padding>
                     <children>
                        <Label style="-fx-font-family: -apple-system, 'SF Pro Display', 'Segoe UI', sans-serif; -fx-font-weight: bold; -fx-font-size: 18px; -fx-text-fill: #1d1d1f;" text="Usuários Cadastrados" />
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <Label style="-fx-text-fill: #6e6e73;" text="Filtrar por:" />
                              <ComboBox fx:id="cbFiltro" prefWidth="110.0" style="-fx-background-color: #F2F2F7; -fx-background-radius: 6px;" />
                              <TextField fx:id="txtPesquisa" promptText="Digite para pesquisar..." style="-fx-background-color: #F2F2F7; -fx-background-radius: 8px; -fx-padding: 6px;" HBox.hgrow="ALWAYS" />
                              <Button fx:id="btnLimparPesquisa" mnemonicParsing="false" onAction="#aoLimparPesquisa" style="-fx-background-color: #e5e5ea; -fx-background-radius: 6px; -fx-cursor: hand;" text="Limpar" />
                           </children>
                        </HBox>
                        <TableView fx:id="tabelaUsuarios" prefHeight="400.0" prefWidth="545.0" style="-fx-border-color: #e5e5ea; -fx-border-radius: 8px; -fx-background-radius: 8px;" VBox.vgrow="ALWAYS">
                           <columns>
                              <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
                              <TableColumn fx:id="colNome" prefWidth="130.0" text="Nome" />
                              <TableColumn fx:id="colEmail" prefWidth="150.0" text="E-mail" />
                              <TableColumn fx:id="colPerfil" prefWidth="95.0" text="Perfil" />
                              <TableColumn fx:id="colAtivo" prefWidth="100.0" text="Status" />
                           </columns>
                        </TableView>
                     </children>
                  </VBox>

                 
                  <VBox fx:id="painelCadastro" spacing="10.0" visible="false">
                     <padding>
                        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
                     </padding>
                     <children>
                        <Label fx:id="lblCadTitulo" style="-fx-font-family: -apple-system, 'SF Pro Display', 'Segoe UI', sans-serif; -fx-font-weight: bold; -fx-font-size: 18px; -fx-text-fill: #1d1d1f;" text="Cadastrar Cliente" />
                        <Label style="-fx-text-fill: #6e6e73;" text="Nome:" />
                        <TextField fx:id="txtCadNome" promptText="Nome completo" style="-fx-background-color: #F2F2F7; -fx-background-radius: 8px; -fx-padding: 8px;" />
                        <Label style="-fx-text-fill: #6e6e73;" text="E-mail:" />
                        <TextField fx:id="txtCadEmail" promptText="E-mail" style="-fx-background-color: #F2F2F7; -fx-background-radius: 8px; -fx-padding: 8px;" />
                        <Label style="-fx-text-fill: #6e6e73;" text="CPF:" />
                        <TextField fx:id="txtCadCpf" promptText="CPF" style="-fx-background-color: #F2F2F7; -fx-background-radius: 8px; -fx-padding: 8px;" />
                        <Label style="-fx-text-fill: #6e6e73;" text="Senha:" />
                        <PasswordField fx:id="txtCadSenha" promptText="Senha" style="-fx-background-color: #F2F2F7; -fx-background-radius: 8px; -fx-padding: 8px;" />
                        <Pane prefHeight="10.0" />
                        <Button fx:id="btnCadSalvar" mnemonicParsing="false" onAction="#aoSalvarCadastro" style="-fx-background-color: #007AFF; -fx-text-fill: white; -fx-background-radius: 8px; -fx-font-weight: bold; -fx-padding: 8 20 8 20; -fx-cursor: hand;" text="Salvar" />
                        <Label fx:id="lblCadMensagem" style="-fx-font-weight: bold;" />
                     </children>
                  </VBox>

                  <VBox fx:id="painelBusca" spacing="12.0" visible="false">
                     <padding>
                        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
                     </padding>
                     <children>
                        <Label style="-fx-font-family: -apple-system, 'SF Pro Display', 'Segoe UI', sans-serif; -fx-font-weight: bold; -fx-font-size: 18px; -fx-text-fill: #1d1d1f;" text="Buscar Usuário por ID" />
                        <HBox spacing="10.0">
                           <children>
                              <TextField fx:id="txtBuscaId" promptText="ID do usuário" style="-fx-background-color: #F2F2F7; -fx-background-radius: 8px; -fx-padding: 8px;" />
                              <Button mnemonicParsing="false" onAction="#aoConfirmarBusca" style="-fx-background-color: #e5e5ea; -fx-text-fill: #1d1d1f; -fx-background-radius: 8px; -fx-font-weight: bold; -fx-cursor: hand;" text="Buscar" />
                           </children>
                        </HBox>
                        <Label fx:id="lblBuscaResultado" style="-fx-font-size: 14px;" wrapText="true" />
                     </children>
                  </VBox>
               </children>
            </StackPane>
         </children>
      </AnchorPane>
   </children>
</AnchorPane>