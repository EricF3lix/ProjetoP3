<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="apresentacao.fx.MenuFornecedoresController">
   <padding>
      <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
   </padding>
   <top>
      <Label style="-fx-font-size: 22px; -fx-font-weight: bold;" text="Gerenciar Fornecedores" BorderPane.alignment="CENTER_LEFT">
         <BorderPane.margin>
            <Insets bottom="12.0" />
         </BorderPane.margin>
      </Label>
   </top>
   <left>
      <VBox prefWidth="260.0" spacing="8.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets right="12.0" />
         </padding>
         <children>
            <TextField fx:id="pesquisa" promptText = "Busque pelo nome ou CNPJ"/>
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#buscarFornecedor" text="Buscar Fornecedor por ID" />
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#cadastrarFornecedor" text="Cadastrar Fornecedor" />
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#listarFornecedores" text="Listar todas os Fornecedores" />
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#atualizarFornecedor" text="Atualizar Fornecedor" />
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#desativarFornecedor" text="Desativar Fornecedor" />
            <Separator />
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#voltar" text="Voltar" />
         </children>
      </VBox>
   </left>
   <center>
      <TableView fx:id="tabela" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
        <columnResizePolicy>
               <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
        <columns>
          <TableColumn prefWidth="40.0" text="ID">
             <cellValueFactory><PropertyValueFactory property="id" /></cellValueFactory>
          </TableColumn>
          <TableColumn prefWidth="89.0" text="Razão Social">
             <cellValueFactory><PropertyValueFactory property="razaoSocial" /></cellValueFactory>
          </TableColumn>
          <TableColumn prefWidth="118.0" text="CNPJ">
             <cellValueFactory><PropertyValueFactory property="cnpj" /></cellValueFactory>
          </TableColumn>
          <TableColumn prefWidth="167.0" text="Email">
             <cellValueFactory><PropertyValueFactory property="email" /></cellValueFactory>
          </TableColumn>
          <TableColumn prefWidth="115.0" text="Telefone">
             <cellValueFactory><PropertyValueFactory property="telefone" /></cellValueFactory>
          </TableColumn>
          <TableColumn prefWidth="78.0" text="Ativo">
             <cellValueFactory><PropertyValueFactory property="ativo" /></cellValueFactory>
          </TableColumn>
        </columns>
      </TableView>
   </center>
</BorderPane>
