<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="apresentacao.fx.MenuRelatoriosController">
   <left>
      <VBox prefHeight="359.0" prefWidth="199.0" BorderPane.alignment="CENTER">
         <children>
            <Label alignment="CENTER" prefHeight="41.0" prefWidth="251.0" text="Relatorios" textAlignment="CENTER" wrapText="true">
               <font>
                  <Font name="System Bold" size="20.0" />
               </font>
            </Label>
            <TextField fx:id="pesquisa" />
            <Button alignment="CENTER" contentDisplay="TOP" layoutX="10.0" mnemonicParsing="false" onAction="#itensPorCategoria" prefHeight="47.0" prefWidth="189.0" text="Itens disponíveis por categoria" textAlignment="CENTER" wrapText="true">
               <VBox.margin>
                  <Insets bottom="3.0" left="5.0" right="5.0" top="5.0" />
               </VBox.margin>
            </Button>
            <Button mnemonicParsing="false" onAction="#historicoAlugueisCliente" prefHeight="47.0" prefWidth="189.0" text="Histórico de aluguéis de um cliente" textAlignment="CENTER" wrapText="true">
               <VBox.margin>
                  <Insets bottom="3.0" left="5.0" right="5.0" top="3.0" />
               </VBox.margin>
            </Button>
            <Button mnemonicParsing="false" onAction="#alugados" prefHeight="47.0" prefWidth="189.0" text="Itens alugados no momento" textAlignment="CENTER" wrapText="true">
               <VBox.margin>
                  <Insets bottom="3.0" left="5.0" right="5.0" top="3.0" />
               </VBox.margin>
            </Button>
            <Button mnemonicParsing="false" onAction="#relatorioPeriodo" prefHeight="47.0" prefWidth="189.0" text="Relatório de faturamento por período" textAlignment="CENTER" wrapText="true">
               <VBox.margin>
                  <Insets bottom="3.0" left="5.0" right="5.0" top="3.0" />
               </VBox.margin>
               <font>
                  <Font size="12.0" />
               </font>
            </Button>
            <Separator prefHeight="15.0" prefWidth="199.0" />
            <Button mnemonicParsing="false" onAction="#voltar" prefHeight="26.0" prefWidth="300.0" text="Voltar" textAlignment="CENTER" wrapText="true">
               <VBox.margin>
                  <Insets bottom="3.0" left="5.0" right="5.0" top="3.0" />
               </VBox.margin>
            </Button>
         </children>
      </VBox>
   </left>
   <padding>
      <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
   </padding>
   <right>
      <TableView fx:id="tabela" prefHeight="568.0" prefWidth="659.0" BorderPane.alignment="CENTER">
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </right>
</BorderPane>
