<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600.0" prefWidth="950.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="apresentacao.fx.MenuItensController">
   <padding>
      <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
   </padding>
   <top>
      <Label style="-fx-font-size: 22px; -fx-font-weight: bold;" text="Gerenciar Itens" BorderPane.alignment="CENTER_LEFT">
         <BorderPane.margin>
            <Insets bottom="12.0" />
         </BorderPane.margin>
      </Label>
   </top>
   <left>
      <VBox prefWidth="270.0" spacing="8.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets right="12.0" />
         </padding>
         <children>
            <!-- Barra de Pesquisa com Filtro -->
            <Label style="-fx-font-weight: bold;" text="Pesquisar Itens:" />
            <ComboBox fx:id="cbFiltro" maxWidth="1.7976931348623157E308" />
            <HBox spacing="6.0">
               <children>
                  <TextField fx:id="pesquisa" promptText="Digite para buscar..." HBox.hgrow="ALWAYS" />
                  <Button fx:id="btnLimparPesquisa" mnemonicParsing="false" onAction="#aoLimparPesquisa" text="Limpar" />
               </children>
            </HBox>
            <Separator />
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#buscarItem" text="Buscar Item por ID" />
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#cadastrarItem" text="Cadastrar Item" />
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#listarItens" text="Listar todos os Itens" />
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#atualizarItem" text="Atualizar Item" />
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#desativarItem" text="Desativar Item" />
            <Separator />
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#voltar" text="Voltar" />
         </children>
      </VBox>
   </left>
   <center>
      <TableView fx:id="tabela" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
        <columnResizePolicy>
               <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
        <columns>
          <TableColumn prefWidth="50.0" text="ID">
             <cellValueFactory><PropertyValueFactory property="id" /></cellValueFactory>
          </TableColumn>
          <TableColumn prefWidth="150.0" text="Nome">
             <cellValueFactory><PropertyValueFactory property="nome" /></cellValueFactory>
          </TableColumn>
          <TableColumn prefWidth="120.0" text="Categoria">
             <cellValueFactory><PropertyValueFactory property="categoria" /></cellValueFactory>
          </TableColumn>
