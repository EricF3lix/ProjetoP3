<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<StackPane prefHeight="660.0" prefWidth="950.0" style="-fx-background-color: #F5F5F7;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="apresentacao.fx.MenuPrincipalFuncionarioController">
   <children>
      <VBox alignment="TOP_CENTER" maxHeight="640.0" maxWidth="450.0" spacing="12.0" style="-fx-background-color: #ffffff; -fx-background-radius: 20px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 25, 0, 0, 8);">
         <padding>
            <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
         </padding>
         <children>
            <HBox alignment="CENTER" spacing="12.0">
               <children>
                  <StackPane prefHeight="45.0" prefWidth="45.0">
                     <children>
                        <Circle fill="#34c759" radius="22.5" />
                        <Label style="-fx-font-family: -apple-system, 'SF Pro Text', sans-serif; -fx-font-weight: bold; -fx-font-size: 15px; -fx-text-fill: white;" text="FC" />
                     </children>
                  </StackPane>
                  <VBox alignment="CENTER_LEFT" spacing="2.0">
                     <children>
                        <Label style="-fx-font-family: -apple-system, 'SF Pro Text', sans-serif; -fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #1d1d1f;" text="Funcionário" />
                        <Label fx:id="lblBemVindo" style="-fx-font-family: -apple-system, 'SF Pro Text', 'Segoe UI', sans-serif; -fx-font-size: 13px; -fx-text-fill: #86868b;" text="Bem-vindo(a)" />
                     </children>
                  </VBox>
               </children>
               <VBox.margin>
                  <Insets bottom="5.0" />
               </VBox.margin>
            </HBox>

            <Separator style="-fx-padding: 0 0 5 0;" />
            
            <!-- Botões de Navegação Principal -->
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#abrirUsuarios" prefHeight="42.0" style="-fx-background-color: #F2F2F7; -fx-background-radius: 12px; -fx-text-fill: #1d1d1f; -fx-font-weight: bold; -fx-font-size: 14px; -fx-cursor: hand;" text="Usuários" />
            
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#abrirItens" prefHeight="42.0" style="-fx-background-color: #F2F2F7; -fx-background-radius: 12px; -fx-text-fill: #1d1d1f; -fx-font-weight: bold; -fx-font-size: 14px; -fx-cursor: hand;" text="Itens" />
            
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#abrirCategorias" prefHeight="42.0" style="-fx-background-color: #F2F2F7; -fx-background-radius: 12px; -fx-text-fill: #1d1d1f; -fx-font-weight: bold; -fx-font-size: 14px; -fx-cursor: hand;" text="Categorias" />
            
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#abrirFornecedores" prefHeight="42.0" style="-fx-background-color: #F2F2F7; -fx-background-radius: 12px; -fx-text-fill: #1d1d1f; -fx-font-weight: bold; -fx-font-size: 14px; -fx-cursor: hand;" text="Fornecedores" />
            
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#abrirContratos" prefHeight="42.0" style="-fx-background-color: #F2F2F7; -fx-background-radius: 12px; -fx-text-fill: #1d1d1f; -fx-font-weight: bold; -fx-font-size: 14px; -fx-cursor: hand;" text="Contratos" />
            
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#abrirMultas" prefHeight="42.0" style="-fx-background-color: #F2F2F7; -fx-background-radius: 12px; -fx-text-fill: #1d1d1f; -fx-font-weight: bold; -fx-font-size: 14px; -fx-cursor: hand;" text="Multas" />
            
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#abrirRelatorios" prefHeight="42.0" style="-fx-background-color: #e5f1ff; -fx-background-radius: 12px; -fx-text-fill: #007AFF; -fx-font-weight: bold; -fx-font-size: 14px; -fx-cursor: hand;" text="Relatórios" />
            
            <Separator style="-fx-padding: 3 0 0 0;" />
            
            <!-- Botão de Sair -->
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#voltar" prefHeight="42.0" style="-fx-background-color: #fff0f0; -fx-background-radius: 12px; -fx-text-fill: #ff3b30; -fx-font-weight: bold; -fx-font-size: 14px; -fx-cursor: hand;" text="Encerrar Sessão" />
         </children>
      </VBox>
   </children>
</StackPane>