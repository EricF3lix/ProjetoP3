<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="332.0" prefWidth="602.0" style="-fx-background-color: light gray;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="apresentacao.fx.MenuPrincipalFuncionarioController">
   <top>
      <HBox BorderPane.alignment="CENTER">
         <children>
            <MenuBar nodeOrientation="LEFT_TO_RIGHT" HBox.hgrow="ALWAYS">
               <menus>
                  <Menu fx:id="lblBemVindo" mnemonicParsing="false" text="Bem Vindo(a)">
                     <items>
                        <MenuItem mnemonicParsing="false" style="-fx-background-color: red;" text="Action 1" />
                     </items>
                  </Menu>
               </menus>
            </MenuBar>
            <Button mnemonicParsing="false" onAction="#voltar" prefHeight="26.0" prefWidth="136.0" style="-fx-background-color: red; -fx-text-fill: white; -fx-background-radius: 0;" text="Encerrar sessão" wrapText="true" />
         </children>
      </HBox>
   </top>
   <center>
      <VBox alignment="CENTER" spacing="15.0" BorderPane.alignment="CENTER">
         <children>
            <Button alignment="CENTER" mnemonicParsing="false" onAction="#abrirUsuarios" prefWidth="180.0" text="Usuarios" />
            <Button mnemonicParsing="false" onAction="#abrirItens" prefWidth="180.0" text="Itens" />
            <Button mnemonicParsing="false" onAction="#abrirCategorias" prefWidth="180.0" text="Categorias" />
            <Button mnemonicParsing="false" onAction="#abrirFornecedores" prefHeight="26.0" prefWidth="180.0" text="Fornecedores" />
            <Button mnemonicParsing="false" onAction="#abrirContratos" prefWidth="180.0" text="Contratos" />
            <Button mnemonicParsing="false" onAction="#abrirMultas" prefWidth="180.0" text="Multas" />
            <Button mnemonicParsing="false" onAction="#abrirRelatorios" prefWidth="180.0" text="Relatorios" />
         </children>
         <padding>
            <Insets bottom="30.0" />
         </padding>
      </VBox>
   </center>
</BorderPane>